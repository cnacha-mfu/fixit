// ═══ Security Rules ขั้นต่ำ — "กุญแจประตูหน้าบ้าน" (สัปดาห์ที่ 7) ═══
//
// กฎมีข้อเดียว: ต้องล็อกอินก่อน ถึงอ่านหรือเขียนได้ ทุกโฟลเดอร์
//
// ⚠️ ยังไม่ปลอดภัยจริง — ใครสมัครบัญชีใหม่ก็อ่านข้อมูลทุกคนได้
//    กฎรายห้องครบชุดมาในสัปดาห์ที่ 8 · ระหว่างนี้ห้ามใส่ข้อมูลจริงของใคร
//
// deploy ด้วย: firebase deploy --only firestore:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // request.auth != null = ผู้ใช้ล็อกอินอยู่จริง
      allow read, write: if request.auth != null;
    }
  }
}
