# ─────────────────────────────────────────────────────────────
# .gitignore ของ FixIt — "รายชื่อสิ่งที่ห้ามส่งขึ้น GitHub"
# (อิงเทมเพลตของหลักสูตร RAISE 2)
# ─────────────────────────────────────────────────────────────


# ── ชิ้นส่วนที่ npm ติดตั้งให้ (ใหญ่มาก และสร้างใหม่ได้เสมอ) ──
node_modules/


# ── 🔑 ของลับ ห้ามหลุดเด็ดขาด ──
# API key ของ OpenRouter (สัปดาห์ที่ 8) — คัดลอกจาก js/config.example.js
config.js
js/config.js
secrets.js

# ค่าตั้งค่า Firebase ของเครื่องผู้สอน (คัดลอกจาก js/firebase-config.example.js)
js/firebase-config.js
.env
.env.local
.env.*

# ไฟล์คีย์ระดับผู้ดูแลของ Firebase
*serviceAccount*.json
*firebase-adminsdk*.json
.firebaserc.local

# ชี้โปรเจกต์ Firebase ของเครื่องผู้สอน (คัดลอกจาก .firebaserc.example)
.firebaserc


# ── ไฟล์ที่ Firebase สร้างเอง ──
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log


# ── ไฟล์ที่เครื่องเราสร้างเอง ──
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/


# ── การทดสอบ (สัปดาห์ที่ 9) ──
# มีรหัสผ่านบัญชีทดสอบ (คัดลอกจาก tests/test-config.example.js)
tests/test-config.js
test-results/
playwright-report/
blob-report/
